<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>


<VBox alignment="CENTER" spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.proyecto.controlador.PrimaryController" stylesheets= "@colores.css">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <Label text="Tres en Raya" styleClass="texto-principal">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <VBox alignment="CENTER_LEFT" spacing="8.0">
            <children>
                <Label text="Selecciona tu símbolo:" styleClass="texto-secundario" />
                <HBox alignment="CENTER" spacing="10" >
                    <children>
                        <ToggleButton fx:id="btnX" text="X" prefWidth="80" prefHeight="80" selected="true" styleClass="simbolo">
                            <toggleGroup><ToggleGroup fx:id="grupoSimbolo" /></toggleGroup>
                        </ToggleButton>
                        <ToggleButton fx:id="btnO" text="O" prefWidth="80" prefHeight="80" toggleGroup="$grupoSimbolo" styleClass="simbolo"/>
                    </children>
                </HBox>
            </children>
        </VBox>

        <VBox alignment="CENTER_LEFT" spacing="8.0">
            <children>
                <Label text="Modo de Juego:" styleClass="texto-secundario"/>
                <HBox alignment="CENTER" spacing="10" >
                    <children>
                        <ToggleButton fx:id="btnJvsM" text="Jugador vs Maquina" selected="true" styleClass="boton">
                            <toggleGroup><ToggleGroup fx:id ="grupoModo" /></toggleGroup>
                        </ToggleButton>
                        <ToggleButton fx:id="btnJvsJ" text="Jugador vs Jugador" toggleGroup="$grupoModo" styleClass="boton"/>
                    </children>
                </HBox>
             </children>
        </VBox>
      
        <Button fx:id="btnIniciar" mnemonicParsing="false" onAction="#handleIniciar" prefWidth="100.0" style="-fx-background-color: #38bdf8; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" text="Iniciar" />
    </children>
</VBox>
